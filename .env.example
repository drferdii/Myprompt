# Sentra Prompt — Environment Template
# Copy to .env.local and fill in real values. .env.local is gitignored.

# Database (Supabase PostgreSQL — Direct connection for Prisma)
DATABASE_URL=
DIRECT_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
QWEN_API_KEY=
XAI_API_KEY=

# Encryption (for user API keys stored in DB)
ENCRYPTION_KEY=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Observability
NEXT_PUBLIC_SENTRY_DSN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3013

# Respan LLM observability (consumed by @the-abyss/observability)
RESPAN_API_KEY=

# Evaluator dimension weights (optional — all default to 0.25, normalized to sum 1.0)
EVAL_WEIGHT_STRUCTURE=0.25
EVAL_WEIGHT_CLARITY=0.25
EVAL_WEIGHT_COMPLETENESS=0.25
EVAL_WEIGHT_SPECIFICITY=0.25
